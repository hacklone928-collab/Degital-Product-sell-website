{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and roles",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "moderator", "admin", "super_admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Product": {
      "title": "Digital Product",
      "description": "Metadata for software, plugins, or scripts",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "tags": { "type": "array" },
        "imageUrl": { "type": "string" },
        "videoUrl": { "type": "string", "description": "YouTube or Vimeo video URL" },
        "discountPrice": { "type": "number", "description": "Discounted price when discount is enabled" },
        "discountEnabled": { "type": "boolean", "description": "Whether to use the discount price" },
        "fileUrl": { "type": "string", "description": "Private link or storage path" },
        "fileName": { "type": "string" },
        "enableSizes": { "type": "boolean", "description": "Whether this product has size options" },
        "availableSizes": { "type": "array", "description": "List of available sizes for this product" },
        "licenseType": { "type": "string", "enum": ["single", "multiple"] },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "category"]
    },
    "Order": {
      "title": "Transaction Order",
      "description": "Details of a product purchase",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "productId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed", "failed"] },
        "amount": { "type": "number", "description": "Gross amount before discount" },
        "discountAmount": { "type": "number", "description": "Discount applied" },
        "netAmount": { "type": "number", "description": "Final paid amount" },
        "affiliateBonus": { "type": "number", "description": "Bonus earned by affiliate" },
        "affiliateId": { "type": "string", "description": "UID of the affiliate/assignee" },
        "couponCode": { "type": "string" },
        "currency": { "type": "string" },
        "paymentIntentId": { "type": "string" },
        "downloadToken": { "type": "string" },
        "licenseKey": { "type": "string" },
        "division": { "type": "string" },
        "district": { "type": "string" },
        "upazila": { "type": "string" },
        "union": { "type": "string" },
        "village": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "productId", "status", "amount", "netAmount"]
    },
    "Settings": {
      "title": "Site Settings",
      "description": "Global website configuration",
      "type": "object",
      "properties": {
        "siteName": { "type": "string" },
        "heroTitle": { "type": "string" },
        "heroSubtitle": { "type": "string" },
        "footerText": { "type": "string" },
        "logoUrl": { "type": "string" },
        "faviconUrl": { "type": "string" },
        "heroTitleSizeMobile": { "type": "string" },
        "heroTitleSizeDesktop": { "type": "string" },
        "heroSubtitleSizeMobile": { "type": "string" },
        "heroSubtitleSizeDesktop": { "type": "string" },
        "heroTitleColor": { "type": "string" },
        "heroSubtitleColor": { "type": "string" },
        "heroBanners": { 
          "type": "array",
          "description": "List of banner objects for the hero slider"
        },
        "enableBinancePay": { "type": "boolean" },
        "binanceId": { "type": "string" },
        "binanceQR": { "type": "string" },
        "enablePayoneer": { "type": "boolean" },
        "payoneerEmail": { "type": "string" },
        "cartText": { "type": "string" },
        "viewText": { "type": "string" },
        "buyText": { "type": "string" },
        "cartColor": { "type": "string" },
        "viewColor": { "type": "string" },
        "buyColor": { "type": "string" },
        "cartTextColor": { "type": "string" },
        "viewTextColor": { "type": "string" },
        "buyTextColor": { "type": "string" },
        "chatAiEnabled": { "type": "boolean" },
        "chatAiSystemPrompt": { "type": "string", "description": "Custom system instructions for the AI Support bot" },
        "chatWelcomeMessage": { "type": "string" },
        "chatHeaderTitle": { "type": "string", "description": "Title text at the top of the chat box" },
        "chatHeaderSubtitle": { "type": "string", "description": "Subtitle text at the top of the chat box" },
        "chatStartTitle": { "type": "string", "description": "Title shown before chat starts" },
        "chatStartSubtitle": { "type": "string", "description": "Subtitle shown before chat starts" },
        "chatStartButtonText": { "type": "string", "description": "Text for the start chat button" },
        "chatPoweredByText": { "type": "string", "description": "Branding text at the bottom of the chat box" },
        "chatInputPlaceholder": { "type": "string", "description": "Placeholder text for the chat input field" },
        "refundPolicy": { "type": "string" },
        "paymentMethods": { "type": "string" },
        "showThemeToggle": { "type": "boolean", "description": "Whether to show the Night Mode toggle button to users" }
      },
      "required": ["siteName"]
    },
    "Category": {
      "title": "Product Category",
      "description": "Categories for filtering products",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "hidden": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name"]
    },
    "Review": {
      "title": "Product Review",
      "description": "User feedback and rating for a product",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "productId": { "type": "string", "description": "Helper for collectionGroup queries" },
        "productName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "rating", "comment"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount codes for checkout",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "type": { "type": "string", "enum": ["percentage", "fixed"] },
        "value": { "type": "number" },
        "bonusPercentage": { "type": "number", "description": "Percentage of net sale to give as bonus" },
        "expiryDate": { "type": "string", "format": "date-time" },
        "isActive": { "type": "boolean" },
        "usageCount": { "type": "number" },
        "usageLimit": { "type": "number" },
        "assignedEmail": { "type": "string", "format": "email", "description": "Email of the user this coupon is assigned to" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "type", "value", "expiryDate", "isActive"]
    },
    "ConnectionTest": {
      "title": "Connection Test",
      "description": "Minimal document for connectivity verification",
      "type": "object",
      "properties": {
        "status": { "type": "string" }
      }
    },
    "AffiliateCommission": {
      "title": "Affiliate Commission",
      "description": "Record of earned commission by an affiliate",
      "type": "object",
      "properties": {
        "affiliateId": { "type": "string" },
        "orderId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "paid"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["affiliateId", "orderId", "amount", "status"]
    },
    "RevenueStatistic": {
      "title": "Revenue Statistic",
      "description": "Aggregated daily or monthly financial data",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date", "description": "YYYY-MM-DD" },
        "grossSales": { "type": "number" },
        "totalDiscount": { "type": "number" },
        "netRevenue": { "type": "number" },
        "totalBonus": { "type": "number" },
        "totalProfit": { "type": "number" },
        "orderCount": { "type": "number" }
      },
      "required": ["date", "grossSales", "netRevenue", "orderCount"]
    },
    "ActiveSession": {
      "title": "Active Session",
      "description": "Real-time presence tracking for users",
      "type": "object",
      "properties": {
        "lastSeen": { "type": "string", "format": "date-time" },
        "uid": { "type": ["string", "null"] },
        "email": { "type": ["string", "null"] },
        "path": { "type": "string" }
      },
      "required": ["lastSeen", "path"]
    },
    "ChatSession": {
      "title": "Chat Session",
      "description": "A conversation between a user/guest and support",
      "type": "object",
      "properties": {
        "userId": { "type": ["string", "null"] },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "solved", "blocked"] },
        "isPinned": { "type": "boolean" },
        "isArchived": { "type": "boolean" },
        "lastMessage": { "type": "string" },
        "lastTimestamp": { "type": "string", "format": "date-time" },
        "aiEnabled": { "type": "boolean" },
        "adminId": { "type": ["string", "null"] },
        "unreadCount": { "type": "number" },
        "typingStatus": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userName", "status", "createdAt"]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "Individual message in a chat session",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderType": { "type": "string", "enum": ["user", "admin", "ai"] },
        "text": { "type": "string" },
        "imageUrl": { "type": "string" },
        "isDeleted": { "type": "boolean" },
        "reactions": { "type": "object", "description": "Map of emoji to count or userIds" },
        "productCard": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "price": { "type": "number" },
            "imageUrl": { "type": "string" }
          }
        },
        "replyTo": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "text": { "type": "string" },
            "senderType": { "type": "string" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "seen": { "type": "boolean" }
      },
      "required": ["sessionId", "senderId", "senderType", "createdAt"]
    },
    "PaymentGateway": {
      "title": "Payment Gateway",
      "description": "Payment gateway configuration (SSLCommerz, ShurjoPay)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "gateway_name": { "type": "string" },
        "is_active": { "type": "boolean" },
        "sandbox_mode": { "type": "boolean" },
        "store_id": { "type": "string" },
        "store_password": { "type": "string" },
        "secret_key": { "type": "string" },
        "prefix": { "type": "string" },
        "success_url": { "type": "string" },
        "failed_url": { "type": "string" },
        "cancel_url": { "type": "string" },
        "ipn_url": { "type": "string" },
        "logo": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["gateway_name", "is_active"]
    }
  },
  "firestore": {
    "/payment_gateways/{gatewayId}": {
      "schema": "PaymentGateway",
      "description": "Payment gateways configuration"
    },
    "/chat_sessions/{sessionId}": {
      "schema": "ChatSession",
      "description": "Chat conversations"
    },
    "/chat_messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Messages within chat sessions"
    },
    "/active_sessions/{sessionId}": {
      "schema": "ActiveSession",
      "description": "Real-time user presence tracking"
    },
    "/test/connection": {
      "schema": "ConnectionTest",
      "description": "Public checkpoint for testing Firestore availability"
    },
    "/settings/site": {
      "schema": "Settings",
      "description": "Global site configuration settings"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual user profiles"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Public catalog of digital items"
    },
    "/products/{productId}/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Product reviews"
    },
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Discount coupons"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Purchase records"
    },
    "/commissions/{commissionId}": {
      "schema": "AffiliateCommission",
      "description": "Affiliate earnings"
    },
    "/stats/{statId}": {
      "schema": "RevenueStatistic",
      "description": "Financial summaries"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Product categories"
    }
  }
}
