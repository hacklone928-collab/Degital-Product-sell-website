{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and roles",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "moderator", "admin", "super_admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Product": {
      "title": "Digital Product",
      "description": "Metadata for software, plugins, or scripts",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "tags": { "type": "array" },
        "imageUrl": { "type": "string" },
        "fileUrl": { "type": "string", "description": "Private link or storage path" },
        "fileName": { "type": "string" },
        "licenseType": { "type": "string", "enum": ["single", "multiple"] },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "category"]
    },
    "Order": {
      "title": "Transaction Order",
      "description": "Details of a product purchase",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "productId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed", "failed"] },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "paymentIntentId": { "type": "string" },
        "downloadToken": { "type": "string" },
        "licenseKey": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "productId", "status", "amount"]
    },
    "Settings": {
      "title": "Site Settings",
      "description": "Global website configuration",
      "type": "object",
      "properties": {
        "siteName": { "type": "string" },
        "heroTitle": { "type": "string" },
        "heroSubtitle": { "type": "string" },
        "footerText": { "type": "string" },
        "logoUrl": { "type": "string" },
        "faviconUrl": { "type": "string" },
        "heroTitleSizeMobile": { "type": "string" },
        "heroTitleSizeDesktop": { "type": "string" },
        "heroSubtitleSizeMobile": { "type": "string" },
        "heroSubtitleSizeDesktop": { "type": "string" },
        "heroTitleColor": { "type": "string" },
        "heroSubtitleColor": { "type": "string" },
        "heroBanners": { 
          "type": "array",
          "description": "List of banner objects for the hero slider"
        }
      },
      "required": ["siteName"]
    },
    "Category": {
      "title": "Product Category",
      "description": "Categories for filtering products",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "hidden": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name"]
    },
    "Review": {
      "title": "Product Review",
      "description": "User feedback and rating for a product",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "rating", "comment"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount codes for checkout",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "type": { "type": "string", "enum": ["percentage", "fixed"] },
        "value": { "type": "number" },
        "expiryDate": { "type": "string", "format": "date-time" },
        "isActive": { "type": "boolean" },
        "usageCount": { "type": "number" },
        "assignedEmail": { "type": "string", "format": "email", "description": "Email of the user this coupon is assigned to" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "type", "value", "expiryDate", "isActive"]
    },
    "ConnectionTest": {
      "title": "Connection Test",
      "description": "Minimal document for connectivity verification",
      "type": "object",
      "properties": {
        "status": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/test/connection": {
      "schema": "ConnectionTest",
      "description": "Public checkpoint for testing Firestore availability"
    },
    "/settings/site": {
      "schema": "Settings",
      "description": "Global site configuration settings"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual user profiles"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Public catalog of digital items"
    },
    "/products/{productId}/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Product reviews"
    },
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Discount coupons"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Purchase records"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Product categories"
    }
  }
}
