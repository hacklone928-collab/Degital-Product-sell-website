rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(roles) {
      return isSignedIn() && (
        request.auth.token.email in ['businessonline.6251@gmail.com', 'hacklone928@gmail.com'] || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         getUserData().role in roles)
      );
    }

    function isSuperAdmin() { return hasRole(['super_admin']); }
    function isAdmin() { return hasRole(['super_admin', 'admin']); }
    function isModerator() { return hasRole(['super_admin', 'admin', 'moderator']); }

    // Faster admin check for list operations to avoid get()
    function isHardcodedAdmin() {
      return isSignedIn() && request.auth.token.email in ['businessonline.6251@gmail.com', 'hacklone928@gmail.com'];
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // Settings (Super Admin Only)
    match /settings/site {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Admin Logs
    match /admin_logs/{logId} {
      allow read: if isModerator();
      allow create: if isModerator(); // Admins/Moderators can log their own actions
      allow update, delete: if false;
    }

    // Connection Test
    match /test/connection {
      allow read: if true;
    }

    // Pages
    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users
    match /users/{userId} {
      allow read: if isOwner(userId) || isModerator();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'bonusBalance']))) || 
                   (isSuperAdmin()) ||
                   (isAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) && resource.data.role != 'super_admin');
      
      // Separate rule for role management
      allow update: if isAdmin() && 
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt']) &&
                    request.resource.data.role in ['user', 'moderator', 'admin'] &&
                    resource.data.role != 'super_admin';
    }

    // Products
    match /products/{productId} {
      allow read: if true;
      allow delete: if isAdmin();
      allow update: if isAdmin() || (isModerator() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'views']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
      ));
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewCount', 'updatedAt', 'views']);
      allow create: if isAdmin();

      // Reviews Subcollection
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isModerator() || (isSignedIn() && resource.data.userId == request.auth.uid);
      }
    }

    // Coupons
    match /coupons/{couponId} {
      allow list: if true;
      allow get: if true;
      allow write: if isModerator();
    }

    // Withdrawals
    match /withdrawals/{withdrawalId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isModerator() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isModerator();
      allow delete: if isSuperAdmin();
    }

    // Orders
    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isModerator());
      allow list: if isHardcodedAdmin() || isModerator() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isModerator();
    }

    // Affiliate Commissions
    match /commissions/{commissionId} {
      allow read: if isModerator() || (isSignedIn() && resource.data.affiliateId == request.auth.uid);
      allow write: if isModerator();
    }

    // Revenue Statistics
    match /stats/{statId} {
      allow read: if isModerator();
      allow write: if isAdmin();
    }

    // Support Tickets
    match /support_tickets/{ticketId} {
      allow create: if true; // Guest can send tickets
      allow read, write: if isModerator();
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isModerator();
    }

    // Active Sessions
    match /active_sessions/{sessionId} {
      allow list: if isModerator();
      allow get: if isModerator();
      allow create, update: if true; // Allow guests and users to track presence
      allow delete: if true; // Sessions are short-lived
    }
  }
}
